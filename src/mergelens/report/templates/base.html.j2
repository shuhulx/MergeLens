<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <script>{{ plotly_js | safe }}</script>
  <style>
    :root { color-scheme:light; --ink:#172033; --muted:#5b6475; --line:#dfe4ec; --accent:#234e8a; }
    * { box-sizing:border-box; }
    body { margin:0; font:15px/1.5 system-ui,sans-serif; color:var(--ink); background:#f4f6fa; }
    header { padding:32px 20px; color:white; background:#18345d; }
    main, header>div { max-width:1180px; margin:auto; }
    h1 { margin:0 0 6px; } h2 { margin-top:0; color:var(--accent); }
    .card { margin:20px 0; padding:22px; background:white; border:1px solid var(--line); border-radius:10px; }
    .notice { border-left:5px solid #d97706; }
    table { width:100%; border-collapse:collapse; }
    th,td { padding:8px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
    th { background:#f7f8fb; } .scroll { overflow:auto; max-height:520px; }
    code { font-size:.9em; } pre { overflow:auto; padding:14px; color:#d8efc7; background:#202b35; }
    .muted { color:var(--muted); }
  </style>
</head>
<body>
<header><div><h1>{{ title }}</h1><div>Evidence-aware static checkpoint inspection</div></div></header>
<main>
{% if compare %}
  <section class="card notice">
    <h2>Evidence boundary</h2>
    <p>This report contains direct checkpoint measurements and hand-specified heuristics. It does not establish downstream merged-model quality, capability retention, or an optimal merge method. Post-merge behavioural evaluation remains necessary.</p>
    <p><strong>Validation:</strong> {{ compare.mci.validation_status }} · <strong>Risk tier:</strong> {{ compare.mci.risk_tier }} · <strong>Evidence coverage:</strong> {{ "%.0f%%"|format(compare.mci.evidence_coverage * 100) }}</p>
  </section>
  <section class="card"><div id="heuristic-gauge"></div></section>
  <section class="card">
    <h2>Pairwise comparison coverage</h2>
    <div class="scroll"><table><thead><tr><th>Reference</th><th>Candidate</th><th>Role</th><th>Exact tensors</th><th>Common parameters</th><th>Reference coverage</th><th>Candidate coverage</th><th>Scoring</th><th>Warnings / unsupported</th></tr></thead><tbody>
    {% for c in compare.coverage %}<tr>
      <td><code>{{ c.reference_model }}</code></td><td><code>{{ c.candidate_model }}</code></td><td>{{ c.reference_role.value }}</td>
      <td>{{ c.exact_shape_compatible_tensor_count }} / {{ c.common_tensor_name_count }}</td><td>{{ c.common_parameter_count }}</td>
      <td>{{ "%.1f%%"|format(c.parameter_coverage_reference * 100) if c.parameter_coverage_reference is not none else "unknown" }}</td>
      <td>{{ "%.1f%%"|format(c.parameter_coverage_candidate * 100) if c.parameter_coverage_candidate is not none else "unknown" }}</td>
      <td>{{ "supported" if c.scoring_supported else "suppressed" }}</td><td>{{ (c.warnings + c.unsupported_conditions)|join(" ") }}</td>
    </tr>{% endfor %}</tbody></table></div>
  </section>
  <section class="card">
    <h2>Metric availability ({{ compare.mci.available_metrics|length }}/{{ compare.metadata.total_diagnostic_signals }})</h2>
    <table><thead><tr><th>Signal</th><th>Status</th><th>Computed rows</th><th>Reason</th></tr></thead><tbody>
    {% for a in compare.metric_availability %}<tr><td><code>{{ a.metric }}</code></td><td>{{ a.status.value }}</td><td>{{ a.computed_tensor_count }}/{{ a.affected_tensor_count }} ({{ "%.1f%%"|format(a.parameter_coverage * 100) if a.parameter_coverage is not none else "n/a" }} params)</td><td>{{ a.reason or "" }}</td></tr>{% endfor %}
    </tbody></table>
  </section>
  {% if compare.candidate_set_metrics %}<section class="card"><h2>Candidate-set task-vector measurements</h2>
  <p class="muted">These values describe the explicit base and the complete candidate set; they are not pair metrics and do not enter pair assessments.</p>
  <div class="scroll"><table><thead><tr><th>Base</th><th>Candidates</th><th>Position</th><th>Tensor</th><th>Sign disagreement</th><th>TSV</th></tr></thead><tbody>
  {% for m in compare.candidate_set_metrics %}<tr><td><code>{{ m.base_model }}</code></td><td>{{ m.candidate_models|join(", ") }}</td><td>{{ m.tensor_position }}</td><td><code>{{ m.tensor_name }}</code></td><td>{{ "%.4f"|format(m.sign_disagreement_rate) if m.sign_disagreement_rate is not none else "-" }}</td><td>{{ "%.4f"|format(m.tsv_interference) if m.tsv_interference is not none else "-" }}</td></tr>{% endfor %}
  </tbody></table></div></section>{% endif %}
  {% if compare.activation_metrics %}<section class="card"><h2>Activation-layer CKA measurements</h2>
  <p class="muted">CKA remains activation-layer evidence and is not broadcast to weight tensors or included in the aggregate. High-dimensional estimates require a matched null baseline.</p>
  <div class="scroll"><table><thead><tr><th>Pair</th><th>Activation layer</th><th>CKA</th><th>Samples</th><th>Feature widths</th><th>Warnings</th></tr></thead><tbody>
  {% for m in compare.activation_metrics %}<tr><td>{{ m.comparison_id }}</td><td><code>{{ m.activation_layer }}</code></td><td>{{ "%.4f"|format(m.cka_similarity) }}</td><td>{{ m.sample_count }}</td><td>{{ m.reference_feature_count }} / {{ m.candidate_feature_count }}</td><td>{{ m.warnings|join(" ") }}</td></tr>{% endfor %}
  </tbody></table></div></section>{% endif %}
  <section class="card"><div id="heatmap-chart"></div></section>
  <section class="card"><div id="spectral-chart"></div></section>
  <section class="card"><div id="tensor_metrics-chart"></div></section>
  <section class="card"><div id="conflicts-chart"></div></section>
  <section class="card">
    <h2>Attributable raw tensor measurements</h2>
    <div class="scroll"><table><thead><tr><th>Pair</th><th>Reference</th><th>Candidate</th><th>Position</th><th>Block</th><th>Tensor</th><th>Cosine</th><th>Normalized L2</th><th>Spectral</th><th>Rank ratio</th><th>Sign disagreement</th><th>TSV</th><th>Energy</th><th>CKA</th></tr></thead><tbody>
    {% for m in compare.tensor_metrics %}<tr>
      <td>{{ m.comparison_id }}</td><td><code>{{ m.reference_model }}</code></td><td><code>{{ m.candidate_model }}</code></td><td>{{ m.tensor_position }}</td><td>{{ m.transformer_block if m.transformer_block is not none else "-" }}</td><td><code>{{ m.tensor_name }}</code></td>
      <td>{{ "%.4f"|format(m.cosine_similarity) if m.cosine_similarity is not none else "-" }}</td><td>{{ "%.4f"|format(m.l2_distance) if m.l2_distance is not none else "-" }}</td><td>{{ "%.4f"|format(m.spectral_overlap) if m.spectral_overlap is not none else "-" }}</td><td>{{ "%.4f"|format(m.effective_rank_ratio) if m.effective_rank_ratio is not none else "-" }}</td><td>{{ "%.4f"|format(m.sign_disagreement_rate) if m.sign_disagreement_rate is not none else "-" }}</td><td>{{ "%.4f"|format(m.tsv_interference) if m.tsv_interference is not none else "-" }}</td><td>{{ "%.4f"|format(m.task_vector_energy) if m.task_vector_energy is not none else "-" }}</td><td>{{ "%.4f"|format(m.cka_similarity) if m.cka_similarity is not none else "-" }}</td>
    </tr>{% endfor %}</tbody></table></div>
  </section>
  {% if compare.tensor_conflict_regions %}<section class="card"><h2>Heuristic tensor inspection priorities</h2>
  {% for r in compare.tensor_conflict_regions %}<p><strong>{{ r.comparison_id }} positions {{ r.start_tensor_position }}-{{ r.end_tensor_position }}</strong>: {{ r.heuristic_inspection_note }}<br><span class="muted">Signals: {{ r.triggering_signals|join("; ") }} · Tensors: {{ r.tensor_names|join(", ") }}</span></p>{% endfor %}</section>{% endif %}
  {% if compare.strategy %}<section class="card"><h2>Rule-based MergeKit starting configuration</h2>
    <p><strong>Method:</strong> {{ compare.strategy.method.value }} · <strong>Heuristic rule strength:</strong> {{ "%.0f%%"|format(compare.strategy.heuristic_strength * 100) }} · <strong>Config status:</strong> {{ compare.strategy.config_status }}</p>
    <p>{{ compare.strategy.reasoning }}</p>{% for warning in compare.strategy.warnings %}<p class="muted">{{ warning }}</p>{% endfor %}<pre>{{ compare.strategy.mergekit_yaml }}</pre>
  </section>{% endif %}
{% endif %}
{% if diagnose %}<section class="card"><h2>Configuration diagnosis scope</h2><p>Status: {{ diagnose.analysis_status }}</p><p>Honoured: {{ diagnose.honored_features|join(", ") or "none" }}</p><p>Ignored: {{ diagnose.ignored_features|join(", ") or "none" }}</p><p>Unsupported: {{ diagnose.unsupported_features|join(", ") or "none" }}</p></section>{% endif %}
</main>
<script>
{% for chart_id, chart_data in charts.items() %}
try { const spec_{{ chart_id }}={{ chart_data|tojson }}; Plotly.newPlot("{{ chart_id }}-{{ 'gauge' if chart_id == 'heuristic' else 'chart' }}",spec_{{ chart_id }}.data,spec_{{ chart_id }}.layout,{responsive:true}); } catch(error) { console.warn("Chart {{ chart_id }} skipped", error); }
{% endfor %}
</script>
</body>
</html>
